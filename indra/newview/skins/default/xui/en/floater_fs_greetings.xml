<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 name="fs_greetings"
 title="Greetings"
 can_resize="true"
 height="470"
 width="470"
 min_width="380"
 min_height="400"
 layout="topleft"
 save_rect="true"
 single_instance="true">
	<string name="bad_patterns">These patterns aren't valid regular expressions and are left out:
[ERRORS]</string>
	<string name="not_a_welcome">Not a welcome.</string>
	<string name="welcome_no_names">A welcome, but no names to look for.</string>
	<string name="welcome_names">A welcome. Words looked for in the names of nearby people: [NAMES]</string>
	<tab_container
	 follows="all"
	 layout="topleft"
	 left="1"
	 right="-1"
	 top="2"
	 bottom="-1"
	 name="greetings_tabs"
	 tab_position="top"
	 tab_height="20"
	 tab_min_width="80">
		<panel
		 border="true"
		 follows="all"
		 layout="topleft"
		 label="Welcome"
		 name="welcome_panel">
			<text
			 follows="left|top|right"
			 layout="topleft"
			 left="10"
			 right="-10"
			 top="8"
			 height="44"
			 wrap="true"
			 name="welcome_help">
A line you say in nearby chat is a welcome when one of these patterns matches it. Nearby people named in the rest of the line are ticked as greeted. One regular expression per line; case is ignored.
			</text>
			<text_editor
			 follows="left|top|right"
			 layout="topleft"
			 left="10"
			 right="-10"
			 top_pad="4"
			 height="90"
			 max_length="4096"
			 word_wrap="false"
			 name="welcome_patterns" />
			<text
			 follows="left|top|right"
			 layout="topleft"
			 left="10"
			 right="-10"
			 top_pad="8"
			 height="30"
			 wrap="true"
			 name="not_welcome_help">
Never a welcome: parts of a line these patterns match are left out first, such as "you're welcome".
			</text>
			<text_editor
			 follows="left|top|right"
			 layout="topleft"
			 left="10"
			 right="-10"
			 top_pad="4"
			 height="60"
			 max_length="4096"
			 word_wrap="false"
			 name="not_welcome_patterns" />
			<text
			 follows="left|top|right"
			 layout="topleft"
			 left="10"
			 right="-10"
			 top_pad="6"
			 height="44"
			 wrap="true"
			 text_color="Red"
			 name="welcome_errors" />
			<text
			 follows="left|top"
			 layout="topleft"
			 left="10"
			 top_pad="6"
			 height="16"
			 width="200"
			 name="welcome_test_label">
Try a line:
			</text>
			<line_editor
			 follows="left|top|right"
			 layout="topleft"
			 left="10"
			 right="-10"
			 top_pad="2"
			 height="22"
			 max_length_bytes="1023"
			 name="welcome_test" />
			<text
			 follows="left|top|right"
			 layout="topleft"
			 left="10"
			 right="-10"
			 top_pad="4"
			 height="44"
			 wrap="true"
			 name="welcome_result" />
		</panel>
	</tab_container>
</floater>
